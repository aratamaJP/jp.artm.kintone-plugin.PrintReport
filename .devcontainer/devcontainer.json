// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
    "name": "Node.js & TypeScript",
    // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
    "image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-trixie",

    // Geminiのセキュリティ要件に合わせて、マウント先を変更する（Node.jsイメージ用）
    "workspaceFolder": "/home/node/${localWorkspaceFolderBasename}",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/node/${localWorkspaceFolderBasename},type=bind,consistency=cached",

    "customizations": {
        "vscode": {
            // コンテナ起動時に自動インストールするVSCode拡張機能を指定
            "extensions": [
				// Gemini拡張機能
                "google.geminicodeassist"
            ],
            "settings": {
				// Geminiの Agentにすべてのアクションを許可する設定
                "geminicodeassist.agentYoloMode": true
            }
        }
    }

}
